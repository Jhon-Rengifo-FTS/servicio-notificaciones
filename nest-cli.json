{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/notificaciones_email/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/notificaciones_email/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/notificaciones_email",
  "projects": {
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "notificaciones_email": {
      "type": "application",
      "root": "apps/notificaciones_email",
      "entryFile": "main",
      "sourceRoot": "apps/notificaciones_email/src",
      "compilerOptions": {
        "tsConfigPath": "apps/notificaciones_email/tsconfig.app.json"
      }
    },
    "notificaciones_push": {
      "type": "application",
      "root": "apps/notificaciones_push",
      "entryFile": "main",
      "sourceRoot": "apps/notificaciones_push/src",
      "compilerOptions": {
        "tsConfigPath": "apps/notificaciones_push/tsconfig.app.json"
      }
    },
    "notificaciones_telegram": {
      "type": "application",
      "root": "apps/notificaciones_telegram",
      "entryFile": "main",
      "sourceRoot": "apps/notificaciones_telegram/src",
      "compilerOptions": {
        "tsConfigPath": "apps/notificaciones_telegram/tsconfig.app.json"
      }
    }
  }
}