                    <tbody style="width:100%">
                      <tr style="width:100%">
                        <td
                          style="box-sizing:content-box;vertical-align:top;padding-left:0;padding-right:2px"
                        >
                          <div
                            style="color:#FFFFFF;font-size:12px;font-weight:normal;padding:0px 0px 0px 0px"
                          >
                            <p>
                              Cra. 100 #5-169<br />Oasis de Unicentro, Of. 315
                              A<br />Santiago de Cali, Valle del Cauca.
                            </p>
                            (+57) 310 287 4790</p>
                          </div>
                          <div
                            style="color:#FFFFFF;font-size:12px;font-weight:normal;padding:0px 0px 0px 0px"
